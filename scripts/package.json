{
  "name": "maskify-screenshots",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "screenshot": "node screenshot.js",
    "preview": "node preview.js",
    "icons": "node icons.js",
    "icons:preview": "node icons.js --preview",
    "stores": "node store-assets.js",
    "stores:preview": "node store-assets.js --preview",
    "stores:check": "node store-assets.js --check",
    "stores:version": "node refresh-store-version.js",
    "release:build": "node release-assets.js build",
    "firefox:build": "node firefox-package.js",
    "firefox:lint": "node firefox-package.js --lint",
    "test:firefox": "node --test firefox.test.js",
    "amo:plan": "node amo-publish.js plan",
    "test": "node --test screenshot.test.js masking.test.js icons.test.js store-assets.test.js release-assets.test.js refresh-store-version.test.js firefox-package.test.js amo-publish.test.js"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "selenium-webdriver": "4.38.0",
    "web-ext": "10.8.0"
  }
}
